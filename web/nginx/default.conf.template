# Rendered at container start: the nginx image runs envsubst over this template,
# substituting ${ADMIN_API_URL} and ${ADMIN_API_KEY} (env). nginx runtime vars
# like $uri / $host are NOT env vars, so they are left intact.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Proxy API calls to the admin-api, adding the API key server-side so the
    # browser never holds it.
    location /api/ {
        proxy_pass ${ADMIN_API_URL};
        proxy_set_header x-api-key "${ADMIN_API_KEY}";
        proxy_set_header Host $host;
    }

    # SPA fallback.
    location / {
        try_files $uri /index.html;
    }
}
