# Rendered at container start: the nginx image runs envsubst over this template,
# substituting ${ADMIN_API_URL} and ${ADMIN_API_KEY} (env). nginx runtime vars
# like $uri / $host are NOT env vars, so they are left intact.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Proxy API calls to the admin-api. Operators authenticate via /api/auth/login
    # and the GUI sends its own bearer token, so nginx no longer injects the API
    # key (that key remains for machine/automation clients).
    location /api/ {
        proxy_pass ${ADMIN_API_URL};
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    # SPA fallback.
    location / {
        try_files $uri /index.html;
    }
}
