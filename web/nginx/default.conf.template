# Rendered at container start: the nginx image runs envsubst over this template,
# substituting ${ADMIN_API_URL} and ${ADMIN_API_KEY} (env). nginx runtime vars
# like $uri / $host are NOT env vars, so they are left intact.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Security headers (clickjacking, MIME-sniffing, referrer leakage). CSP is
    # intentionally omitted here — the GUI uses inline styles + Google Fonts, so a
    # CSP must be authored and tested carefully before enabling.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Proxy API calls to the admin-api. Operators authenticate via a session
    # cookie (better-auth) which the browser sends automatically; nginx no longer
    # injects the API key (that key remains for machine/automation clients).
    location /api/ {
        proxy_pass ${ADMIN_API_URL};
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    # SPA fallback.
    location / {
        try_files $uri /index.html;
    }
}
