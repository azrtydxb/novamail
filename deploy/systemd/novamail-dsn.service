[Unit]
Description=novamail DSN/bounce generator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=novamail
Group=novamail
EnvironmentFile=/etc/novamail/novamail.env
ExecStart=/usr/local/bin/novamail-dsn
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/novamail

[Install]
WantedBy=multi-user.target
