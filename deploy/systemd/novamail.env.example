# Copy to /etc/novamail/novamail.env and adjust. Bootstrap config only
# (operational config lives in Postgres).
DSN=postgres://novamail:CHANGEME@127.0.0.1:5432/novamail?sslmode=disable
AMQP_URL=amqp://novamail:CHANGEME@127.0.0.1:5672/
NOVAMAIL_BODY_STORE=/var/lib/novamail/bodies

# ingress
NOVAMAIL_SMTP_ADDR=:2525
NOVAMAIL_SUBMISSION_ADDR=:587
NOVAMAIL_IMPLICIT_ADDR=:465
NOVAMAIL_TLS_CERT=/etc/novamail/tls/tls.crt
NOVAMAIL_TLS_KEY=/etc/novamail/tls/tls.key

# delivery: envelope-encryption KEK (base64 of 32 bytes). DKIM signing is managed
# in the GUI (DKIM keys page → dkim_keys table), not via env.
NOVAMAIL_SECRET_KEY=
NOVAMAIL_PROVIDER_SECRETS=/etc/novamail/provider-secrets
